# Local dev: plain SQLite file, resolved relative to the project root.
# Production (Vercel): swap for a hosted LibSQL/Turso URL (libsql://...)
# and set TURSO_AUTH_TOKEN — see README.
DATABASE_URL="file:./prisma/dev.db"
TURSO_AUTH_TOKEN=

# Secret used to sign the admin session JWT. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# bcrypt hash of the admin password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: Next.js expands $VAR syntax in .env files, which will silently
# corrupt a bcrypt hash (it's full of $-prefixed segments). Escape every "$"
# in the hash as "\$" when you paste it in below, e.g. "\$2b\$10\$abc...".
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash-dollar-signs-escaped"
